# Neon Postgres connection string (required for persisted users, wagers, standings).
# Create a project at https://neon.tech and paste the pooled or HTTP connection URI.
DATABASE_URL=

# Clerk (required for Google / Apple / X sign-in). Never commit real keys.
# Vercel Marketplace may inject NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY instead of CLERK_PUBLISHABLE_KEY;
# the server accepts either name. See AUTH.md.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional. PEM public key for networkless JWT verify (Clerk Dashboard → API keys → JWT public key).
# CLERK_JWT_KEY=

# Optional. When set, POST /api/import and mutating grade-all require header x-admin-key.
ADMIN_KEY=

# Optional. Defaults to 3000 locally.
PORT=3000

# Optional. Default pool slug used when none is supplied.
POOL_SLUG=default
