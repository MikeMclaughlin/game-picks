# Neon Postgres connection string (required for persisted users, wagers, standings).
# Create a project at https://neon.tech and paste the pooled or HTTP connection URI.
DATABASE_URL=

# Optional. When set, POST /api/import and mutating grade-all require header x-admin-key.
ADMIN_KEY=

# Optional. Defaults to 3000 locally.
PORT=3000

# Optional. Default pool slug used when none is supplied.
POOL_SLUG=default
