# Neon Postgres connection string (required for persisted users, wagers, standings).
# Create a project at https://neon.tech and paste the pooled or HTTP connection URI.
DATABASE_URL=

# Google OAuth (required for sign-in). Never commit real keys. See AUTH.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
# Site origin with no trailing slash. Defaults to https://game-picks.vercel.app.
# PUBLIC_BASE_URL=https://game-picks.vercel.app

# Optional. When set, /api/import, /api/grade-all, and /api/cron/scores require
# header x-admin-key (or ?key=). Vercel cron may also send Authorization: Bearer CRON_SECRET.
ADMIN_KEY=
# Optional. Accepted as Bearer token on admin/cron routes when ADMIN_KEY is set.
CRON_SECRET=

# Optional. Defaults to 3000 locally.
PORT=3000

# Optional. Default pool slug used when none is supplied.
POOL_SLUG=default

# Optional. Set to 0/false to disable ESPN live scoreboard fetches (tests do this).
# ESPN_LIVE=1
